# Host-generated by `artisan package:discover`/`composer install` run outside Docker (e.g. dev
# container bind-mount writes, or a contributor's native PHP). If baked into the production image
# via COPY, a dev-only package (e.g. laravel/boost) referenced here breaks `composer --no-dev`:
# php artisan can't boot to regenerate the file because the stale entry no longer resolves.
bootstrap/cache/*.php
.env
.env.*
!.env.example
!.env.docker.example
.phpunit.cache
.phpunit.result.cache
database/*.sqlite
docker-compose*.yml
*.log
.idea
.vscode
