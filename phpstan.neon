includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - Modules/

    excludePaths:
        - Modules/*/tests/*

    level: 7

    ignoreErrors:
        # `BelongsToSession` and `Auditable` (Book A CORE-03/CORE-08) are
        # real, complete mechanisms with no adopting model yet anywhere in
        # the codebase — a genuine, tracked adoption gap (see the spawned
        # follow-up task), not a reason to delete either trait. Silencing
        # the false urgency of a CI-breaking "unused trait" notice here is
        # deliberate; the underlying gap is tracked separately, not hidden.
        -
            identifier: trait.unused
            path: Modules/Core/Domain/Concerns/BelongsToSession.php
        -
            identifier: trait.unused
            path: Modules/Core/Domain/Concerns/Auditable.php
        # `EnforceTokenAbility`'s own docblock explains this tautology is
        # permanent by design: HasApiTokens always provides tokenCan() as
        # of CORE-05, and the method_exists guard is a deliberate defensive
        # duck-type check against a future, different authenticatable —
        # not a mistake PHPStan should keep flagging.
        -
            identifier: function.alreadyNarrowedType
            path: Modules/Core/Http/Middleware/EnforceTokenAbility.php
