includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - Modules/

    excludePaths:
        - Modules/*/tests/*

    level: 7

    ignoreErrors:
        # `BelongsToSession` (Book A CORE-03) is a real, complete mechanism
        # with no adopting model yet anywhere in the codebase — a genuine,
        # tracked adoption gap (see the spawned follow-up task), not a
        # reason to delete the trait. Silencing the false urgency of a
        # CI-breaking "unused trait" notice here is deliberate; the
        # underlying gap is tracked separately, not hidden. `Auditable`
        # (CORE-08) gained its first real adopters in Book J SAA-02
        # (FeatureRollout, ReleaseDeployment, BroadcastAnnouncement,
        # IncidentStatusEntry), so its own entry here is no longer needed.
        -
            identifier: trait.unused
            path: Modules/Core/Domain/Concerns/BelongsToSession.php
        # `EnforceTokenAbility`'s own docblock explains this tautology is
        # permanent by design: HasApiTokens always provides tokenCan() as
        # of CORE-05, and the method_exists guard is a deliberate defensive
        # duck-type check against a future, different authenticatable —
        # not a mistake PHPStan should keep flagging.
        -
            identifier: function.alreadyNarrowedType
            path: Modules/Core/Http/Middleware/EnforceTokenAbility.php
        # `ExecuteCustomReportAction` resolves its query's model class
        # dynamically from `ReportFieldRegistry` (a report entity's
        # `base_model_class`, a controlled list this module's own
        # provider populates — never arbitrary caller input), so
        # PHPStan/Larastan cannot statically know that resolved class
        # uses `BelongsToSchool` and provides `forSchools()`. It is real
        # and reachable at runtime on every entity registered with
        # `defaultSchoolScoped = true`, which is the only case this call
        # is ever reached for (BR-INT-01-006).
        -
            identifier: method.notFound
            path: Modules/Intelligence/Domain/Actions/ExecuteCustomReportAction.php
            message: '#Call to an undefined method Illuminate\\Database\\Eloquent\\Builder.*::forSchools\(\)#'
        # The aggregation SQL fragment `selectRaw()` receives is built
        # from a `match()` over a fixed, literal function-name whitelist
        # (sum/avg/count/min/max — no caller string ever reaches the SQL
        # text directly) and a column name that must already be one of
        # `$aliases` — itself only ever built from `ReportFieldRegistry`
        # entries the running user's own permissions have already
        # cleared. PHPStan's `literal-string` check has no way to express
        # "safe because whitelisted and pre-validated at runtime", only
        # "was this exact string known at compile time" — which no
        # parameterised aggregation column can ever be, by the nature of
        # the feature.
        -
            identifier: argument.type
            path: Modules/Intelligence/Domain/Actions/ExecuteCustomReportAction.php
            message: '#Parameter \#1 \$expression of method Illuminate\\Database\\Eloquent\\Builder.*::selectRaw\(\) expects literal-string#'
        # Larastan misinfers `KpiTarget::where(...)->where(...)->where(...)->first()`
        # as non-nullable here (confirmed empirically: replacing `?->` with
        # `->` produces zero new errors, where a correct nullable inference
        # would flag "access on possibly null" at level 7). It is genuinely
        # nullable at runtime — no target override is the common case, which
        # is the entire reason for the `?? $kpi->defaultTargetValue` fallback
        # immediately after it. Removing the nullsafe operator to satisfy this
        # rule would introduce a real fatal error on the default (no
        # override) path, so the rule is suppressed here, not the code fixed.
        -
            identifier: nullsafe.neverNull
            path: Modules/Intelligence/Domain/Actions/GetKpiValueAction.php
        # Same misinference as above, one call deeper: `$weights->get($key)`
        # (a `Collection<string, RiskScoreWeight>` built from a real, often-
        # empty query) is genuinely nullable — a school with no override
        # for this indicator is the common case, exactly why
        # `?->weight ?? $indicator->defaultWeight` exists. Confirmed
        # empirically the same way (removing `?->` produces zero new
        # errors, where a correct nullable inference would flag "access on
        # possibly null" at level 7).
        -
            identifier: nullsafe.neverNull
            path: Modules/Intelligence/Domain/Actions/ComputeLearnerRiskScoreAction.php
