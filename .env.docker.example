# cp .env.docker.example .env   (used by docker compose for both interpolation and container env)
# Generate a key:  docker compose run --rm --no-deps -e APP_KEY=x app php artisan key:generate --show
APP_NAME=EugemSMS
APP_ENV=production            # docker-compose.override.yml forces "local" in dev
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_KEY=
WEB_PORT=8080
APP_TAG=latest

# Run migrations on app start (the dev override defaults this to true; keep false until you choose in prod)
RUN_MIGRATIONS=false
QUEUE_PROCS=2

# MySQL 8.4 (DB_HOST/PORT/CONNECTION are fixed by docker-compose.yml). CHANGE for production.
DB_DATABASE=eugemsms
DB_USERNAME=eugemsms
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---- Drivers (switch by editing these + COMPOSE_PROFILES; no code change) ----
# Composer packages per mode (status checked against composer.json/lock):
#   database mode : none                                         (default, installed)
#   redis mode    : phpredis ext (baked into the Dockerfile, REDIS_CLIENT=phpredis) -> no package.
#                   predis/predis only if REDIS_CLIENT=predis    (NOT installed)
#   horizon       : laravel/horizon                              (NOT installed; no horizon service defined)
#   s3 mode       : league/flysystem-aws-s3-v3 ^3.0              (NOT installed)
#   ws mode       : laravel/reverb (+ laravel-echo/pusher-js)    (NOT installed; app has no broadcasting
#                   config/channels/events, so no ws service is defined)
COMPOSE_PROFILES=

# Mode 1: database (default)
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Mode 2: redis -> COMPOSE_PROFILES=redis ; set the three below to redis and a password
#SESSION_DRIVER=redis
#CACHE_STORE=redis
#QUEUE_CONNECTION=redis
#REDIS_CLIENT=phpredis
#REDIS_HOST=redis
#REDIS_PORT=6379
REDIS_PASSWORD=

# Mode 3: s3 -> COMPOSE_PROFILES=s3 (or redis,s3) ; needs league/flysystem-aws-s3-v3
# MinIO (dev/self-host): endpoint http://minio:9000, path style true. AWS_* key/secret also become MinIO root creds.
#FILESYSTEM_DISK=s3
#AWS_ACCESS_KEY_ID=minioadmin
#AWS_SECRET_ACCESS_KEY=change-me-min-8-chars
#AWS_DEFAULT_REGION=us-east-1
#AWS_BUCKET=eugemsms
#AWS_ENDPOINT=http://minio:9000
#AWS_USE_PATH_STYLE_ENDPOINT=true
#AWS_URL=
# Garage (production self-host, profile "garage"): COMPOSE_PROFILES=garage
# Generate: GARAGE_RPC_SECRET=$(openssl rand -hex 32)  GARAGE_ADMIN_TOKEN=$(openssl rand -base64 32)
#   AWS_ACCESS_KEY_ID = "GK" + 24 hex (openssl rand -hex 12), AWS_SECRET_ACCESS_KEY = 64 hex (openssl rand -hex 32)
#GARAGE_RPC_SECRET=
#GARAGE_ADMIN_TOKEN=
#GARAGE_KEY_NAME=eugemsms
#GARAGE_CAPACITY=10G
#FILESYSTEM_DISK=s3
#AWS_ACCESS_KEY_ID=GKxxxxxxxxxxxxxxxxxxxxxxxx
#AWS_SECRET_ACCESS_KEY=64-hex-chars
#AWS_DEFAULT_REGION=garage
#AWS_BUCKET=eugemsms
#AWS_ENDPOINT=http://garage:3900
#AWS_USE_PATH_STYLE_ENDPOINT=true
# Real AWS S3: leave AWS_ENDPOINT empty, path style false, do not enable the s3 profile.
# Disk roles (all optional; defaults shown). FILESYSTEM_DISK=s3 alone moves documents.
#DOCUMENTS_DISK=          # private files/generated documents; default = FILESYSTEM_DISK, then local
#PUBLIC_ASSETS_DISK=public # school branding (logo/crest/letterhead); must be publicly readable
#BACKUPS_DISK=backups      # encrypted backups (BACKUP_DISK is a legacy alias)

# Mode 4: ws -> not available until laravel/reverb is approved AND broadcasting code exists.
#BROADCAST_CONNECTION=reverb

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Mail. Dev: mailpit (smtp mailpit:1025, UI http://localhost:8025). Prod: your SMTP relay.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
